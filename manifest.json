{
  "manifest_version": 3,
  "name": "风神考核看板（通用版）",
  "version": "3.7.0",
  "description": "风神页面常驻一颗「看板」总按钮，点开菜单里有两个独立入口：「考核看板」（规划单量完成率、标2骑手占比、考核得分、时段×商圈片达成矩阵）与「出勤达成」（应排/实排/有效出勤、实排达成/应排达成）。两个入口各打开独立页面、各导一张图，互不干扰。出勤达成可选最近 90 天日期（含 T-1 快捷按钮）：今天走实时考勤快照，历史日期走出勤统计的骑手时段明细，全天达成忽略系统错误标记、按有效在线≥6小时且完单≥18单手工判定。跟随当前浏览器登录态，换账号自动换商，无需本地服务。运单本地缓存增量同步，刷新不再全量重拉；支持从 GitHub 自动检查与更新新版本。",
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "scripting",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://*.ele.me/*",
    "https://httpizza.ele.me/*",
    "https://*.aliyuncs.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "fengshen_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开/收起风神考核看板"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.ele.me/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "launcher.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard.html",
        "dashboard.css",
        "dashboard.js",
        "attendance.html",
        "attendance.css",
        "attendance.js",
        "assess.js",
        "sync.js",
        "capture.js",
        "xlsx.js",
        "update-ui.js"
      ],
      "matches": [
        "*://*.ele.me/*"
      ]
    }
  ]
}
